# =====================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =====================================================================
# ⚠️ IMPORTANT: DO NOT RENAME OR DELETE THIS FILE DIRECTLY! ⚠️
# If you rename this file, you will delete the template for the whole team.
#
# 1. COPY (duplicate) this exact file.
# 2. Rename your new COPY to: .env.production.local
# 3. Update the dummy values below with real credentials.
# 2. These exact variable names must be added to your live server's 
#    environment variables settings (e.g., in AWS, Heroku, or Vercel).
# 3. WARNING: Never commit real production secrets to GitHub!
# =====================================================================

# Base URLs
VITE_API_URL=https://api.yourdomain.com/api

# Google Urls and Ids
VITE_CLIENT_URL=https://yourdomain.com
VITE_GOOGLE_CLIENT_ID=your_google_auth_id
