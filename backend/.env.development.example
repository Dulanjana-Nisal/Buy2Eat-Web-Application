# =====================================================================
# LOCAL DEVELOPMENT SETUP
# =====================================================================
# ⚠️ IMPORTANT: DO NOT RENAME THIS FILE DIRECTLY! ⚠️
# If you rename this file, you will delete the template for the whole team.
#
# 1. COPY (duplicate) this exact file.
# 2. Rename your new COPY to: .env.development.local
# 3. Update the dummy values below with your real local credentials.
# 4. Request the JWT secrets and Email passwords from the backend lead.
# 5. NEVER push your real .env.development.local file to GitHub.
# =====================================================================

# Ports
PORT=5000

# Database URI (Replace with your own connection string)
MONGO_URI=mongodb://<username>:<password>@<your-cluster-url>/?ssl=true&authSource=admin

# JWT Keys
ACCESS_SECRET=replace-with-a-long-random-secret
REFRESH_SECRET=replace-with-a-long-random-secret

ACCESS_EXPIRED='15m'
REFRESH_EXPIRED='7d'

# Email Security Codes
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_app_password

# Frontend URL
CLIENT_URL=http://localhost:5173
