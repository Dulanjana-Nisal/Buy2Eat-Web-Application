# =====================================================================
# LOCAL DEVELOPMENT SETUP
# =====================================================================
# 1. Copy this file and rename it to: .env.development.local
# 2. Update the dummy values below with your local development credentials.
# 3. Request the JWT secrets and Email passwords from the backend lead.
# 4. NEVER push your real .env.development.local file to GitHub.
# =====================================================================

# Ports
PORT=5000

# Database URI (Replace with your own connection string)
MONGO_URI=mongodb://<username>:<password>@<your-cluster-url>/?ssl=true&authSource=admin

# JWT Keys
ACCESS_SECRET=replace-with-a-long-random-secret
REFRESH_SECRET=replace-with-a-long-random-secret

ACCESS_EXPIRED='15m'
REFRESH_EXPIRED='7d'

# Email Security Codes
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_app_password

# Frontend URL
CLIENT_URL=http://localhost:5173
