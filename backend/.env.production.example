# =====================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =====================================================================
# 1. Rename this file to: .env.production.local (if testing the production build locally).
# 2. These exact variable names must be added to your live server's 
#    environment variables settings (e.g., in AWS, Heroku, or Vercel).
# 3. WARNING: Never commit real production secrets to GitHub!
# =====================================================================

# Server Setup
PORT=8080
NODE_ENV=production

# Live Database URI (Replace with production cluster string)
MONGO_URI=mongodb://<prod_username>:<prod_password>@<production-cluster-url>/?ssl=true&authSource=admin

# JWT Keys (Must be extremely strong, random strings for production)
ACCESS_SECRET=replace-with-a-highly-secure-production-secret
REFRESH_SECRET=replace-with-a-highly-secure-production-secret

ACCESS_EXPIRED='15m'
REFRESH_EXPIRED='7d'

# Email Security Codes (Use production/business email account)
EMAIL_USER=admin@your-live-domain.com
EMAIL_APP_PASSWORD=your_16_digit_app_password

# Live Frontend URL (Where your React app is actually hosted)
CLIENT_URL=https://www.your-live-domain.com
